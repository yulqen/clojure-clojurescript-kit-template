{:nrepl {:port 7002}
 :source-paths ["src/cljs"]
 :dependencies [[cider/cider-nrepl "0.57.0"]
                [binaryage/devtools "1.0.7"]
                [cljs-ajax "0.8.4"] [reagent "1.2.0"]]
 :builds       {:app {:target     :browser
                      :output-dir "target/classes/cljsbuild/public/js"
                      :asset-path "/js"
                      :modules    {:app {:entries [yulqen.guestbook.core]
                                         :init-fn yulqen.guestbook.core/init!}}
                      :devtools   {:after-load yulqen.guestbook.core/mount-root
                                   :watch-dir  "resources/public/css"
                                   :reload-strategy :hot}}}}
